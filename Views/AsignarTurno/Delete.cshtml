@model MorfeoWeb.Models.AsignarTurno

@{
    ViewData["Title"] = "Remover Turno";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border border-danger-subtle">
                <div class="card-header bg-danger text-white py-3 text-center">
                    <h5 class="card-title mb-0">¿Remover Turno Programado?</h5>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="text-muted">Se eliminará al empleado de este horario específico:</p>

                    <div class="bg-light p-3 rounded text-start mb-4">
                        <div class="mb-1"><span class="text-secondary small">Fecha:</span> <strong class="text-dark">@Html.DisplayFor(model => model.Fecha)</strong></div>
                        <div class="mb-1"><span class="text-secondary small">ID Empleado:</span> <span>#@Html.DisplayFor(model => model.IdEmpleadoNavigation.IdEmpleado)</span></div>
                        <div><span class="text-secondary small">ID Turno:</span> <span>#@Html.DisplayFor(model => model.IdTurnoNavigation.IdTurno)</span></div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="IdAsignacionTurno" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg shadow-sm">
                                Confirmar y Desprogramar
                            </button>
                            <a asp-action="Index" class="btn btn-link text-muted">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>