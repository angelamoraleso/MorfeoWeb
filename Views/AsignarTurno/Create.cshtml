@model MorfeoWeb.Models.AsignarTurno

@{
    ViewData["Title"] = "Asignar Turno";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="card-title mb-0">Asignar Turno de Trabajo</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Fecha" class="form-label fw-bold text-secondary">Fecha del Turno</label>
                            <input asp-for="Fecha" class="form-control form-control-lg" type="date" />
                            <span asp-validation-for="Fecha" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdEmpleado" class="form-label fw-bold text-secondary">Empleado</label>
                            <select asp-for="IdEmpleado" class="form-select form-select-lg" asp-items="ViewBag.IdEmpleado"></select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="IdTurno" class="form-label fw-bold text-secondary">Horario / Turno</label>
                            <select asp-for="IdTurno" class="form-select form-select-lg" asp-items="ViewBag.IdTurno"></select>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                Registrar Turno
                            </button>
                            <a asp-action="Index" class="btn btn-link text-muted">Volver al listado</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}