@model MorfeoWeb.Models.AsignarTurno

@{
    ViewData["Title"] = "Editar Turno";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="card-title mb-0">Modificar Turno Asignado</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="IdAsignacionTurno" />

                        <div class="mb-3">
                            <label asp-for="Fecha" class="form-label fw-bold text-secondary">Fecha</label>
                            <input asp-for="Fecha" class="form-control" />
                            <span asp-validation-for="Fecha" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdEmpleado" class="form-label fw-bold text-secondary">Empleado</label>
                            <select asp-for="IdEmpleado" class="form-select" asp-items="ViewBag.IdEmpleado"></select>
                            <span asp-validation-for="IdEmpleado" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="IdTurno" class="form-label fw-bold text-secondary">Turno asignado</label>
                            <select asp-for="IdTurno" class="form-select" asp-items="ViewBag.IdTurno"></select>
                            <span asp-validation-for="IdTurno" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                Actualizar Cambios
                            </button>
                            <a asp-action="Index" class="btn btn-link text-muted">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}