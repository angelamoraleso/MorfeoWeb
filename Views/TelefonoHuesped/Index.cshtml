@model IEnumerable<MorfeoWeb.Models.TelefonoHuesped>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Numero)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdHuespedNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Numero)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdHuespedNavigation.IdHuesped)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdTelefonoHuesped">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdTelefonoHuesped">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdTelefonoHuesped">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
