@model IEnumerable<MorfeoWeb.Models.Barrio>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.nombre_barrio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.nombre_barrio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdLocalidadNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.nombre_barrio)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.nombre_barrio)
            </td>
            <td>
                @(item.IdLocalidadNavigation?.IdLocalidad.ToString() ?? "N/A")
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdBarrio">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdBarrio">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdBarrio">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
