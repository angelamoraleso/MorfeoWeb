@model IEnumerable<MorfeoWeb.Models.Localidad>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NombreLocalidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CodigoPostal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdCiudadNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NombreLocalidad)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CodigoPostal)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdCiudadNavigation.IdCiudad)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdLocalidad">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdLocalidad">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdLocalidad">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
