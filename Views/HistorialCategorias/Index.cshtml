@model IEnumerable<MorfeoWeb.Models.HistorialCategoria>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FechaCambio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MotivoCambio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdEstrellasNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdHotelNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FechaCambio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MotivoCambio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdEstrellasNavigation.IdEstrellas)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdHotelNavigation.IdHotel)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdHistoriaCategor">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdHistoriaCategor">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdHistoriaCategor">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
