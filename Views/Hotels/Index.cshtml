@model IEnumerable<MorfeoWeb.Models.Hotel>
@using System.Linq

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().AnioInaguracion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().IdBarrioNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model ?? Enumerable.Empty<MorfeoWeb.Models.Hotel>()) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AnioInaguracion)
            </td>
            <td>
                @item.IdBarrioNavigation?.IdBarrio
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdHotel">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdHotel">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdHotel">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
