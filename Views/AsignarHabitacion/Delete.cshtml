@model MorfeoWeb.Models.AsignarHabitacion

@{
    ViewData["Title"] = "Eliminar Asignación";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border border-danger-subtle">
                <div class="card-header bg-danger text-white py-3 text-center">
                    <h5 class="card-title mb-0">¿Remover esta asignación?</h5>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="text-muted">Se cancelará el vínculo actual de alojamiento en el sistema:</p>

                    <div class="bg-light p-3 rounded text-start mb-4">
                        <div class="mb-1"><span class="text-secondary small">Habitación:</span> <strong>#@Html.DisplayFor(model => model.IdHabitacionNavigation.IdHabitacion)</strong></div>
                        <div class="mb-1"><span class="text-secondary small">Huésped:</span> <span>@Html.DisplayFor(model => model.IdHuespedNavigation.IdHuesped)</span></div>
                        <div><span class="text-secondary small">Reserva:</span> <span>#@Html.DisplayFor(model => model.IdReservaNavigation.IdReserva)</span></div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="IdAsignacion" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg shadow-sm">
                                Confirmar y Eliminar
                            </button>
                            <a asp-action="Index" class="btn btn-link text-muted">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>