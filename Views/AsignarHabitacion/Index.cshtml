@model IEnumerable<MorfeoWeb.Models.AsignarHabitacion>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdHabitacionNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdHuespedNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdReservaNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IdHabitacionNavigation.IdHabitacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdHuespedNavigation.IdHuesped)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdReservaNavigation.IdReserva)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdAsignacion">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdAsignacion">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdAsignacion">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
