@model MorfeoWeb.Models.AgenciaViaje

@{
    ViewData["Title"] = "Editar Agencia";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="card-title mb-0"><i class="bi bi-pencil-square me-2"></i>Editar Agencia</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="IdAgencia" />

                        <div class="mb-4">
                            <label asp-for="Nombre" class="form-label fw-bold text-secondary"></label>
                            <input asp-for="Nombre" class="form-control form-control-lg" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                <i class="bi bi-check-circle me-2"></i>Actualizar Cambios
                            </button>
                            <a asp-action="Index" class="btn btn-link text-muted">Cancelar y regresar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}