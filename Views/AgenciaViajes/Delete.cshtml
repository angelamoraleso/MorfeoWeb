@model MorfeoWeb.Models.AgenciaViaje

@{
    ViewData["Title"] = "Eliminar Agencia";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border border-danger-subtle">
                <div class="card-header bg-danger text-white py-3 text-center">
                    <h5 class="card-title mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>¿Confirmar Eliminación?</h5>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="text-muted">Estás a punto de eliminar permanentemente la siguiente agencia del sistema:</p>

                    <div class="bg-light p-3 rounded mb-4">
                        <span class="text-secondary d-block small">Nombre de la Agencia</span>
                        <strong class="fs-4 text-dark">@Html.DisplayFor(model => model.Nombre)</strong>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="IdAgencia" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg shadow-sm">
                                <i class="bi bi-trash me-2"></i>Sí, Eliminar Registro
                            </button>
                            <a asp-action="Index" class="btn btn-link text-muted">Cancelar y regresar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>