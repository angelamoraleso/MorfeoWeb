@model IEnumerable<MorfeoWeb.Models.AgenciaViaje>

@{
    ViewData["Title"] = "Agencias de Viaje";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 text-primary m-0">Agencias de Viaje</h1>
            <p class="text-muted">Gestiona las agencias asociadas al hotel</p>
        </div>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg"></i> Registrar Nueva Agencia
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.Nombre)</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">
                                    @Html.DisplayFor(modelItem => item.Nombre)
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group font-monospace" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.IdAgencia" class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.IdAgencia" class="btn btn-sm btn-outline-info" title="Detalles">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdAgencia" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>